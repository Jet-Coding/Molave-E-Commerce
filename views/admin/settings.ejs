<!DOCTYPE html>
<html lang="en">
<%- include('../partials/adminHead') %>
<body>
    <!-- FIXED: Use a dedicated settings container class to match admin.css layout -->
    <div class="settings-page-container">
        <%- include('../partials/sidebar') %>
        
        <div class="settings-content">
            <main class="settings-container">
                <!-- Settings Header -->
                <header class="settings-header">
                    <button id="sidebar-toggle" aria-label="Toggle Sidebar">
                        <span class="material-icons-sharp">menu</span>
                    </button>
                    <h1>Settings</h1>
                    <p>Manage your account preferences and system options.</p>
                </header>

                <form class="settings-form" action="/settings/update" method="POST">
                    <!-- Profile Settings Section -->
                    <section class="settings-card">
                        <div class="card-header">
                            <span class="material-icons-outlined">person</span>
                            <h2>Profile Information</h2>
                        </div>
                        
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="username">Username</label>
                                <input type="text" id="username" name="username" value="<%= user ? user.username : '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" name="email" value="<%= user ? user.email : '' %>" required>
                            </div>
                        </div>
                    </section>

                    <!-- Preferences / Toggles Section -->
                    <section class="settings-card">
                        <div class="card-header">
                            <span class="material-icons-outlined">notifications</span>
                            <h2>Preferences & Alerts</h2>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h3>Email Notifications</h3>
                                <p>Receive updates about account activity and security alerts.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="email_notifications" checked>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h3>Two-Factor Authentication</h3>
                                <p>Add an extra layer of security to your account.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="two_factor">
                                <span class="slider"></span>
                            </label>
                        </div>
                    </section>

                    <!-- Password Update Section -->
                    <section class="settings-card">
                        <div class="card-header">
                            <span class="material-icons-outlined">lock</span>
                            <h2>Security</h2>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="current_password">Current Password</label>
                                <input type="password" id="current_password" name="current_password" placeholder="••••••••">
                            </div>

                            <div class="form-group">
                                <label for="new_password">New Password</label>
                                <input type="password" id="new_password" name="new_password" placeholder="••••••••">
                            </div>
                        </div>
                    </section>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="window.location.reload()">Cancel</button>
                        <button type="submit" class="btn-primary">Save Changes</button>
                    </div>
                </form>
            </main>
        </div>
    </div>
    <script src="/js/admin.js"></script>
</body>
</html>
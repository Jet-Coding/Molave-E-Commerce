<!DOCTYPE html>
<html lang="en">
<%- include('../partials/adminHead') %>
<body>
    <div class="users-container">
        <%- include('../partials/sidebar') %>

        <main class="users-content">
            <div class="sidebar-header">
                <button id="sidebar-toggle" aria-label="Toggle Sidebar">
                    <span class="material-icons-sharp">menu</span>
                </button>
                <header class="dashboard-header">
                    <h1>Users</h1>
                    <p>Welcome, <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Users' %></p>
                </header>                
            </div>

    
            <!-- User Database Management Table -->
            <section class="data-section">
                <h2>Registered users</h2>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Email</th> 
                            <th>Role</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof usersList !== 'undefined' && usersList.length > 0) { %>
                            <% usersList.forEach(user => { %>
                                <tr>
                                    <td><%= user.id %></td>
                                    <td><%= user.username %></td>
                                    <td><%= user.email %></td>
                                    <td><span class="role-badge role-<%= user.role %>"><%= user.role %></span></td>
                                    <td><%= user.created_at %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center;">No registered users found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </section>
        </main>
    </div>
    <script src="/js/admin.js"></script>
</body>
</html>
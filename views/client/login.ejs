<!DOCTYPE html>
<html lang="en">
<%- include('../partials/clientHead') %>
<body class="auth-page">
    <main class="login-page">
        <h3>Syn<span class="logo">Dol</span></h3>
        <h2>Login</h2>

        <!-- Display error message if server returns authentication failure -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-danger"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST">
            <div class="form-group">
                <label for="identifier">Email or Username</label>
                <input 
                    type="text" 
                    id="identifier" 
                    name="identifier" 
                    placeholder="username/your@email.com" 
                    required 
                    autocomplete="username"
                />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    placeholder="password" 
                    required
                />
            </div>
            <button type="submit" class="btn-submit">Log In</button>
            <a class="forgot-password" href="/auth/forgot-password">Forgot Password?</a>
            <p style="margin-top: 15px;">Don't have an account? <a href="/auth/register">Register here</a></p>
        </form>
    </main>
</body>
</html>
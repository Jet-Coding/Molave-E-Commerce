<!DOCTYPE html>
<html lang="en">
	<%- include('../partials/clientHead') %>
	<body>
        <!-- Messages Contacts -->
        <div class="messenger-card">
            <!-- Top Navigation Header -->
            <header class="messenger-header">
                <div class="header-title">
                    <h1>Sandbox</h1>
                </div>
                <div class="header-actions">
                    <button class="header-btn" aria-label="Camera"><span class="material-icons-outlined">photo_camera</span></button>
                    <button class="header-btn" aria-label="New Message"><span class="material-icons-outlined">edit</span></button>
                </div>
            </header>

            <!-- Search Bar -->
            <div class="search-box">
                <span class="material-icons-outlined">search</span>
                <input type="text" placeholder="Search Messenger">
            </div>

            <!-- Horizontal "Active Now" Stories Tray -->
            <div class="active-tray">
                <div class="active-user">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=12" alt="Alex Morgan" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <span class="active-name">Alex</span>
                </div>
                <div class="active-user">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=68" alt="Marcus Vance" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <span class="active-name">Marcus</span>
                </div>
                <div class="active-user">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=47" alt="David Miller" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <span class="active-name">David</span>
                </div>
                <div class="active-user">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=33" alt="Emma Watson" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <span class="active-name">Emma</span>
                </div>
            </div>

            <!-- Chat List -->
            <ul class="chat-list">
                <!-- Unread Chat Item -->
                <li class="chat-item unread">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=12" alt="Alex Morgan" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <div class="chat-info">
                        <h3 class="chat-name">Alex Morgan</h3>
                        <p class="chat-snippet">
                            <span class="snippet-text">Hey, are you free for a call?</span>
                            <span class="chat-time">· 2m</span>
                        </p>
                    </div>
                    <div class="unread-indicator"></div>
                </li>

                <!-- Read Chat Item with Sent Status -->
                <li class="chat-item">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=32" alt="Sophia Chen" class="avatar">
                        <span class="status-badge offline"></span>
                    </div>
                    <div class="chat-info">
                        <h3 class="chat-name">Sophia Chen</h3>
                        <p class="chat-snippet">
                            <span class="snippet-text">You: Sounds good, see you then!</span>
                            <span class="chat-time">· 1h</span>
                        </p>
                    </div>
                </li>

                <!-- Unread Chat Item -->
                <li class="chat-item unread">
                    <div class="avatar-wrapper">
                        <img src="https://i.pravatar.cc/150?img=68" alt="Marcus Vance" class="avatar">
                        <span class="status-badge online"></span>
                    </div>
                    <div class="chat-info">
                        <h3 class="chat-name">Marcus Vance</h3>
                        <p class="chat-snippet">
                            <span class="snippet-text">Sent a photo.</span>
                            <span class="chat-time">· 3h</span>
                        </p>
                    </div>
                    <div class="unread-indicator"></div>
                </li>

                <!-- Initials Avatar Chat Item -->
                <li class="chat-item">
                    <div class="avatar-wrapper">
                        <div class="avatar initials">JL</div>
                        <span class="status-badge offline"></span>
                    </div>
                    <div class="chat-info">
                        <h3 class="chat-name">Jessica Lee</h3>
                        <p class="chat-snippet">
                            <span class="snippet-text">Thanks for the update!</span>
                            <span class="chat-time">· Yesterday</span>
                        </p>
                    </div>
                </li>
            </ul>
        </div>
		<script>
			window.currentUser = <%- JSON.stringify(typeof user !== 'undefined' && user ? (user.username || user.email) : 'Client') %>;
			window.currentUserId = <%- JSON.stringify(typeof user !== 'undefined' && user ? user.id : 'client_guest') %>;

			// Client-side Follow Action Handler
			async function followUser(targetUserId) {
				try {
					const response = await fetch('/api/follow', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ followeeId: targetUserId })
					});

					const result = await response.json();
					if (response.ok && result.success) {
						// Reload page to refresh contacts and discover lists
						window.location.reload();
					} else {
						alert(result.error || 'Failed to follow user.');
					}
				} catch (err) {
					console.error('Error following user:', err);
				}
			}
		</script>

		<script src="/socket.io/socket.io.js"></script>
		<script src="/js/client.js"></script>
	</body>
</html>
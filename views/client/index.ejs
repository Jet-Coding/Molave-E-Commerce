<!DOCTYPE html>
<html lang="en">
	<%- include('../partials/clientHead') %>
	<body>
		<%- include('../partials/header') %>
		<!-- Main Container (3-Pane Layout) -->
		<div class="main-container">
			<!-- 2. Left Sidebar (Chats List) -->
			<aside class="sidebar-chats">
				<div class="chats-header">
					<h2>Chats</h2>
					<div class="header-actions">
						<button class="icon-circle"><i class="fa-solid fa-ellipsis"></i></button>
						<button class="icon-circle"><i class="fa-solid fa-pen-to-square"></i></button>
					</div>
				</div>

				<div class="search-bar">
					<i class="fa-solid fa-magnifying-glass"></i>
					<input type="text" placeholder="Search Messenger">
				</div>

				<!-- FILTER CHIPS -->
				<div class="filter-chips">
					<button class="chip active" onclick="switchTab('all')">All</button>
					<button class="chip" onclick="switchTab('unread')">Unread</button>
					<button class="chip" onclick="switchTab('follow')">Follow</button>
					<button class="chip" onclick="switchTab('groups')">Groups</button>
					<button class="chip badge-chip" onclick="switchTab('communities')">Communities</button>
				</div>

				<!-- Sidebar List & Tab Panes -->
				<div class="chat-list" id="sidebar-list-container">
					
					<!-- TAB 1: ALL CONTACTS (Default View) -->
					<div id="tab-content-all" class="tab-pane">
						<% if (typeof contacts !== 'undefined' && contacts.length > 0) { %>
							<% contacts.forEach((contact, index) => { %>
							<div class="chat-item <%= index === 0 ? 'active' : '' %>" data-user-id="<%= contact.id %>" data-username="<%= contact.username %>">
								<div class="avatar-container">
									<img src="https://i.pravatar.cc/150?img=<%= contact.id + 10 %>" alt="<%= contact.username %>">
									<span class="status-badge online"></span>
								</div>
								<div class="chat-details">
									<span class="chat-name"><%= contact.username %></span>
									<p class="chat-preview">You're now connected with <%= contact.username %>.</p>
								</div>
							</div>
							<% }); %>
						<% } else { %>
							<div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
								<p>No contacts yet. Click the "Follow" tab to add users!</p>
							</div>
						<% } %>
					</div>

					<!-- TAB 2: FOLLOW REGISTERED USERS (Database Discovery) -->
					<div id="tab-content-follow" class="tab-pane" style="display: none;">
						<% if (typeof discoverUsers !== 'undefined' && discoverUsers.length > 0) { %>
							<% discoverUsers.forEach((discUser) => { %>
							<div class="chat-item" style="justify-content: space-between;" data-user-id="<%= discUser.id %>">
								<div style="display: flex; align-items: center; gap: 12px; flex: 1; overflow: hidden;">
									<div class="avatar-container" style="width: 40px; height: 40px; flex-shrink: 0;">
										<img src="https://i.pravatar.cc/150?img=<%= discUser.id + 20 %>" alt="<%= discUser.username %>" style="width: 100%; height: 100%; border-radius: 50%;">
										<span class="status-badge online"></span>
									</div>
									<div class="chat-details" style="overflow: hidden;">
										<span class="chat-name"><%= discUser.username %></span>
										<p class="chat-preview"><%= discUser.email %></p>
									</div>
								</div>
								<button class="btn-follow" onclick="followUser('<%= discUser.id %>')">
									Follow
								</button>
							</div>
							<% }); %>
						<% } else { %>
							<div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
								<p>You are following all registered users!</p>
							</div>
						<% } %>
					</div>
				</div>
			</aside>

			<!-- 3. Middle Chat Section -->
			<main class="chat-window">
				<% const activeUser = (typeof contacts !== 'undefined' && contacts.length > 0) ? contacts[0] : null; %>
				<header class="chat-window-header">
					<div class="user-info" data-user-id="<%= activeUser ? activeUser.id : '' %>">
						<div class="avatar-container">
							<img src="https://i.pravatar.cc/150?img=32" alt="<%= activeUser ? activeUser.username : 'User' %>">
							<span class="status-badge online"></span>
						</div>
						<div>
							<span class="user-name"><%= activeUser ? activeUser.username : 'User' %></span>
							<span class="user-status"><%= activeUser ? 'Active now' : 'Active' %></span>
						</div>
					</div>
					<div class="chat-header-actions">
						<button class="icon-btn-purple"><i class="fa-solid fa-phone"></i></button>
						<button class="icon-btn-purple"><i class="fa-solid fa-video"></i></button>
						<button class="icon-btn-purple"><i class="fa-solid fa-circle-info"></i></button>
					</div>
				</header>

				<div class="chat-messages-area">
					<% if (activeUser) { %>
					<div class="chat-profile-card">
						<div class="large-avatar-container">
							<img src="https://i.pravatar.cc/150?img=32" alt="<%= activeUser ? activeUser.username : 'Select a Contact' %>">
							<span class="status-badge online"></span>
						</div>
						<h3><%= activeUser ? activeUser.username : 'Select a Contact' %></h3>
						<p class="subtext">You're friends on Facebook</p>
						<p class="subtext muted">New Facebook profile</p>
					</div>

					<div class="time-divider">You're now friends with <%= (typeof user !== 'undefined' && user) ? (user.username || user.email) : 'Guest' %>.</div>
					<% } else { %>
					<div class="time-divider" style="text-align: center; margin-top: 40px; color: #888;">
						<i class="fa-solid fa-comments" style="font-size: 3rem; margin-bottom: 10px;"></i>
						<p> Select a contact to start chatting. </p>
					</div>	
					<% } %>
				</div>

				<footer class="chat-composer">
					<div class="composer-tools">
						<button class="tool-btn"><i class="fa-solid fa-circle-plus"></i></button>
						<button class="tool-btn"><i class="fa-solid fa-image"></i></button>
						<button class="tool-btn"><i class="fa-solid fa-note-sticky"></i></button>
						<button class="tool-btn"><i class="fa-solid fa-gif"></i></button>
					</div>
					<div class="composer-input-wrapper">
						<input type="text" placeholder="Aa">
						<button class="emoji-btn"><i class="fa-regular fa-face-smile"></i></button>
					</div>
					<button class="like-btn"><i class="fa-solid fa-thumbs-up"></i></button>
				</footer>
			</main>

			<!-- 4. Right Details Panel -->
			<aside class="details-panel">
				<div class="details-profile">
					<div class="large-avatar-container">
						<img src="https://i.pravatar.cc/150?img=32" alt="Janell Rebamba">
						<span class="status-badge online"></span>
					</div>
					<h3><%= activeUser ? activeUser.username : 'User' %></h3>
					<span class="user-status">Active now</span>

					<div class="quick-actions">
						<div class="action-item">
							<button class="action-circle"><i class="fa-solid fa-user"></i></button>
							<span>Profile</span>
						</div>
						<div class="action-item">
							<button class="action-circle"><i class="fa-solid fa-bell"></i></button>
							<span>Mute</span>
						</div>
						<div class="action-item">
							<button class="action-circle"><i class="fa-solid fa-magnifying-glass"></i></button>
							<span>Search</span>
						</div>
					</div>
				</div>

				<div class="accordion-menu">
					<div class="accordion-item">
						<span>Chat Info</span>
						<i class="fa-solid fa-chevron-down"></i>
					</div>
					<div class="accordion-item">
						<span>Customise chat</span>
						<i class="fa-solid fa-chevron-down"></i>
					</div>
					<div class="accordion-item">
						<span>Media, files and links</span>
						<i class="fa-solid fa-chevron-down"></i>
					</div>
					<div class="accordion-item">
						<span>Privacy & support</span>
						<i class="fa-solid fa-chevron-down"></i>
					</div>
				</div>
			</aside>
		</div>

		<script>
			window.currentUser = <%- JSON.stringify(typeof user !== 'undefined' && user ? (user.username || user.email) : 'Client') %>;
			window.currentUserId = <%- JSON.stringify(typeof user !== 'undefined' && user ? user.id : 'client_guest') %>;

			// Client-side Follow Action Handler
			async function followUser(targetUserId) {
				try {
					const response = await fetch('/api/follow', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ followeeId: targetUserId })
					});

					const result = await response.json();
					if (response.ok && result.success) {
						// Reload page to refresh contacts and discover lists
						window.location.reload();
					} else {
						alert(result.error || 'Failed to follow user.');
					}
				} catch (err) {
					console.error('Error following user:', err);
				}
			}

			// Tab switching logic for filter chips
			function switchTab(tabName) {
				// Remove active class from all chips
				document.querySelectorAll('.filter-chips .chip').forEach(btn => btn.classList.remove('active'));
				// Hide all tab panes
				document.querySelectorAll('.tab-pane').forEach(pane => pane.style.display = 'none');
				// Activate selected tab chip and show corresponding pane
				if (tabName === 'all') {
					document.getElementById('tab-content-all').style.display = 'block';
					event.currentTarget.classList.add('active');
				} else if (tabName === 'follow') {
					document.getElementById('tab-content-follow').style.display = 'block';
					event.currentTarget.classList.add('active');
				} else {
					// Fallback for unread/groups/communities placeholder views
					document.getElementById('tab-content-all').style.display = 'block';
					event.currentTarget.classList.add('active');
				}
			}

			// Follow Account Database Action
			async function followUser(targetUserId) {
				try {
					const response = await fetch('/api/follow', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ followeeId: targetUserId })
					});

					const result = await response.json();
					if (response.ok && result.success) {
						// Refresh workspace to reflect new following status
						window.location.reload();
					} else {
						alert(result.error || 'Failed to follow user.');
					}
				} catch (err) {
					console.error('Error following user:', err);
				}
			}
		</script>
		<script src="/socket.io/socket.io.js"></script>
		<script src="/js/client.js"></script>
	</body>
</html>